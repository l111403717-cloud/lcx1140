#!/usr/bin/env bash
# hx — 项目验证、范围审计与交接；使用已有 Python 3，不安装依赖。
set -uo pipefail
if [ -z "${HX_PYTHON:-}" ]; then
  if command -v python3 >/dev/null 2>&1; then HX_PYTHON=python3; else HX_PYTHON=python; fi
fi
export HX_PYTHON
export HX_SHELL="${HX_SHELL:-$BASH}"
# Git Bash 的环境变量不会像命令行参数一样自动转换为 Windows 路径。
if command -v cygpath >/dev/null 2>&1; then
  HX_SHELL=$(cygpath -m "$HX_SHELL")
  for key in HX_STATE_HOME HX_PROJECT_ROOT; do
    if [ -n "${!key:-}" ]; then export "$key=$(cygpath -m "${!key}")"; fi
  done
fi
export PYTHONIOENCODING=utf-8
# resolve() 同时支持 install.sh 创建的符号链接；保留 stdin 给宿主钩子。
exec "$HX_PYTHON" -c 'import pathlib,runpy,sys; p=pathlib.Path(sys.argv[1]).resolve().with_suffix(".py"); sys.argv=[str(p),*sys.argv[2:]]; runpy.run_path(str(p),run_name="__main__")' "$0" "$@"
