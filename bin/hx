#!/usr/bin/env bash
# hx — Harness 确定性执行器：把「探测 / 锁定 / 验证 / 审计 / 拦截」从提示词搬进脚本
# 用法: hx detect | hx lock [--refresh] | hx baseline | hx verify [--quick] | hx audit | hx gc
#       hx handoff [--check] | hx map-check | hx guard | hx stop
set -uo pipefail

# ---- hook 模式：工作目录是 hooks.json 所在目录，需从 stdin 取真实工作区 ----
IN=""
case "${1:-}" in guard|stop)
  IN=$(cat)
  WS=$(printf %s "$IN" | python3 -c 'import sys,json;print((json.load(sys.stdin).get("workspacePaths") or [""])[0])' 2>/dev/null)
  cd "$WS" 2>/dev/null || { [ "$1" = guard ] && echo '{"decision":"allow"}' || echo '{}'; exit 0; } ;;
esac

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); cd "$ROOT" || exit 2
HX=.harness
LOCKDIR="$HOME/.harness-locks/$(printf %s "$ROOT" | shasum | cut -c1-12)"   # 锁放仓库外，模型改不到
LOCK_GLOBS="package.json Makefile Cargo.toml go.mod pyproject.toml tsconfig*.json eslint.config.* .eslintrc* vitest.config.* jest.config.* playwright.config.*"

in_git(){ git rev-parse --git-dir >/dev/null 2>&1; }
run(){ perl -e 'alarm shift; exec @ARGV' "${HX_TIMEOUT:-300}" sh -c "$1"; }   # macOS 没有 timeout 命令
pm(){ [ -f pnpm-lock.yaml ] && { echo pnpm; return; }; [ -f bun.lockb ] && { echo bun; return; }
      [ -f yarn.lock ] && { echo yarn; return; }; echo npm; }
has_script(){ node -e "const s=(require('./package.json').scripts||{})['$1'];process.exit(s&&!/no test specified/.test(s)?0:1)" 2>/dev/null; }

fp(){ in_git || { echo nogit; return; }
  { if git rev-parse --verify HEAD >/dev/null 2>&1; then
      git diff HEAD --binary -- . ':(exclude).harness'
    else
      git diff --binary -- . ':(exclude).harness'
    fi
    git ls-files --others --exclude-standard -- . ':(exclude).harness' | while IFS= read -r f; do
      printf '%s ' "$f"; shasum "$f" 2>/dev/null; done
  } | shasum | cut -c1-8; }

detect(){   # 按「便宜→昂贵」输出验证链，一行一条命令；--quick 只取第一条
  if [ -f package.json ]; then P=$(pm)
    has_script typecheck && echo "$P run typecheck"
    [ -f tsconfig.json ] && ! has_script typecheck && echo "npx --no-install tsc --noEmit"
    for s in lint test build; do has_script "$s" && echo "$P run $s"; done
  fi
  [ -f Cargo.toml ] && { echo "cargo check"; echo "cargo test"; }
  [ -f go.mod ] && { echo "go vet ./..."; echo "go test ./..."; }
  if [ -f pyproject.toml ] || [ -f requirements.txt ]; then
    echo "python3 -m compileall -q -x '(\.venv|node_modules)' ."
    command -v ruff >/dev/null && echo "ruff check ."
    [ -d tests ] && command -v pytest >/dev/null && echo "pytest -q"
  fi
  if [ -f Makefile ]; then for t in check verify test; do grep -qE "^$t:" Makefile && { echo "make $t"; break; }; done; fi
  return 0
}

lock(){ mkdir -p "$LOCKDIR"
  echo "$ROOT" > "$LOCKDIR/repo_root"
  # shellcheck disable=SC2086
  files=$(ls -d $LOCK_GLOBS 2>/dev/null)
  [ -n "$files" ] && shasum -a 256 $files > "$LOCKDIR/lock.sha"
  if in_git && [ "${1:-}" != --refresh ]; then          # 影子基线：不动工作区，把当前脏状态存成一个 ref
    b=$(git stash create 2>/dev/null); git update-ref refs/harness/base "${b:-$(git rev-parse HEAD)}" 2>/dev/null
  fi
  echo "LOCKED $LOCKDIR base=$(git rev-parse --short refs/harness/base 2>/dev/null || echo none)"; }

baseline(){ mkdir -p "$LOCKDIR"; : > "$LOCKDIR/baseline.tsv"   # 记录「改之前」每条命令的退出码与错误数
  echo "$ROOT" > "$LOCKDIR/repo_root"
  detect | while IFS= read -r c; do
    out=$(run "$c" 2>&1); rc=$?; n=$(printf %s "$out" | grep -ciE 'error|failed')
    printf '%s\t%s\t%s\n' "$rc" "$n" "$c" >> "$LOCKDIR/baseline.tsv"
  done; cat "$LOCKDIR/baseline.tsv"; }

audit(){ in_git || { echo "AUDIT SKIP 非 git 仓库"; return 0; }
  base=$(git rev-parse -q --verify refs/harness/base || echo HEAD); bad=0
  git diff "$base" -U0 --no-color -- '*test*' '*spec*' | grep -v '^---' | grep -E '^-.*(expect|assert|it\(|test\(|describe\()' \
    && { echo "AUDIT ✗ 删除/改写了既有断言"; bad=1; }
  git diff "$base" -U0 --no-color | grep -v '^+++' | grep -E '^\+.*(\.(skip|only)\(|@ts-(ignore|nocheck)|eslint-disable|type: *ignore|# *noqa|\|\| *true|exit 0)' \
    && { echo "AUDIT ✗ 新增放水语句"; bad=1; }
  git ls-files --others --exclude-standard | grep -E '^[^/]+\.(py|sh|mjs)$' \
    && { echo "AUDIT ✗ 项目根新增未跟踪脚本"; bad=1; }
  # 检查未跟踪的新文件内容中是否含有放水语句
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [ -f "$f" ] && grep -qE '(\.(skip|only)\(|@ts-(ignore|nocheck)|eslint-disable|type: *ignore|# *noqa|\|\| *true|exit 0)' "$f" 2>/dev/null; then
      echo "AUDIT ✗ 新建未跟踪文件 ($f) 包含放水语句"; bad=1
    fi
  done < <(git ls-files --others --exclude-standard)
  if [ -f "$LOCKDIR/lock.sha" ] && ! shasum -a 256 -c --quiet "$LOCKDIR/lock.sha" >/dev/null 2>&1; then
    echo "AUDIT ✗ 验证入口/配置被改（如属需求，请用户批准后 hx lock --refresh）"; bad=1; fi
  echo "AUDIT changed_files=$( { git diff "$base" --name-only; git ls-files --others --exclude-standard; } | sort -u | grep -c . )"
  return $bad; }

verify(){ mkdir -p "$LOCKDIR/logs"
  local tmp_out
  tmp_out=$(mktemp 2>/dev/null || echo "$LOCKDIR/tmp-verify.log")
  local fail=0 ran=0
  {
    while IFS= read -r c; do [ -z "$c" ] && continue; ran=1
      log="$LOCKDIR/logs/$(printf %s "$c" | tr -c 'A-Za-z0-9' _).log"
      run "$c" >"$log" 2>&1; rc=$?; n=$(grep -ciE 'error|failed' "$log")
      b=$(awk -F'\t' -v c="$c" '$3==c{print $1" "$2}' "$LOCKDIR/baseline.tsv" 2>/dev/null)
      if [ "$rc" -eq 0 ]; then echo "PASS $c"
      elif [ -n "$b" ] && [ "${b%% *}" -ne 0 ] && [ "$n" -le "${b##* }" ]; then
        echo "PRE  $c (改前就失败，错误数 $n ≤ ${b##* }，未恶化)"            # 棘轮：不要求修旧账，只要求不变差
      else echo "FAIL $c (exit $rc, log: $log)"; fail=1; fi
      [ "${1:-}" = --quick ] && break
    done < <(detect)
    [ "$ran" -eq 0 ] && echo "NO_TOOLCHAIN 无可用验证命令 → 仅 diff 审计，需人工冒烟"
    audit || fail=1
    echo "RESULT $([ $fail -eq 0 ] && echo PASS || echo FAIL)"
  } > "$tmp_out" 2>&1
  local cur_fp; cur_fp=$(fp)
  local cur_head; cur_head=$(git rev-parse --short HEAD 2>/dev/null || echo none)
  local cur_time; cur_time=$(date '+%F %T')
  {
    echo "# fp=$cur_fp head=$cur_head time=$cur_time"
    cat "$tmp_out"
  } > "$LOCKDIR/last-verify.txt"
  cat "$tmp_out"
  rm -f "$tmp_out"
  return $fail; }

gc(){
  local locks_dir="$HOME/.harness-locks"
  [ -d "$locks_dir" ] || { echo "GC: $locks_dir 不存在"; return 0; }
  local cleaned=0
  for d in "$locks_dir"/*; do
    [ -d "$d" ] || continue
    local root_file="$d/repo_root"
    if [ -f "$root_file" ]; then
      local repo
      repo=$(cat "$root_file" 2>/dev/null || echo "")
      if [ -z "$repo" ] || [ ! -d "$repo" ]; then
        echo "GC 清理孤儿目录: $d (对应仓库不存在: $repo)"
        rm -rf "$d"
        cleaned=$((cleaned + 1))
      fi
    else
      echo "GC 清理未标识孤儿目录: $d"
      rm -rf "$d"
      cleaned=$((cleaned + 1))
    fi
  done
  echo "GC 完成: 共清理 $cleaned 个残留目录"
}

handoff_check(){
  local plan="$ROOT/.harness/PLAN.md"
  [ ! -f "$plan" ] && { echo "NO_HANDOFF"; return 3; }
  python3 -c '
import sys, re

plan_path = sys.argv[1]
current_fp = sys.argv[2]

with open(plan_path, "r", encoding="utf-8") as f:
    c = f.read()

m = re.search(r"<!-- HANDOFF BEGIN -->([\s\S]*?)<!-- HANDOFF END -->", c)
if not m:
    print("NO_HANDOFF")
    sys.exit(3)

block = m.group(1)
todos = len(re.findall(r"TODO\(agent\)", block))
if todos > 0:
    print(f"INCOMPLETE (TODO 数: {todos})")
    sys.exit(2)

fp_m = re.search(r"\bfp=([A-Za-z0-9]+)", block)
block_fp = fp_m.group(1) if fp_m else ""

if block_fp != current_fp:
    print(f"STALE (handoff fp={block_fp}, current fp={current_fp})")
    sys.exit(1)

print("FRESH")
sys.exit(0)
' "$plan" "$(fp)"
}

handoff(){
  if [ "${1:-}" = "--check" ]; then
    handoff_check
    return $?
  fi

  local cur_fp; cur_fp=$(fp)
  local base_sha; base_sha=$(git rev-parse --short refs/harness/base 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo none)
  local cur_time; cur_time=$(date '+%F %T')

  local files_section=""
  if ! in_git; then
    files_section="- 非 git 仓库：TODO(agent) 手写改动清单"
  else
    local base_ref
    base_ref=$(git rev-parse -q --verify refs/harness/base || git rev-parse -q --verify HEAD 2>/dev/null || echo "")
    local diff_lines=()
    if [ -n "$base_ref" ]; then
      while IFS=$'\t' read -r status path rest; do
        [ -z "$status" ] && continue
        [[ "$path" == .harness/* ]] && continue
        if [[ "$status" =~ ^R ]] && [ -n "$rest" ]; then
          diff_lines+=("- \`$rest\`（R）：TODO(agent)")
        else
          diff_lines+=("- \`$path\`（${status:0:1}）：TODO(agent)")
        fi
      done < <(git diff --name-status "$base_ref" -- . ':(exclude).harness' 2>/dev/null)
    fi
    while IFS= read -r untracked; do
      [ -z "$untracked" ] && continue
      [[ "$untracked" == .harness/* ]] && continue
      diff_lines+=("- \`$untracked\`（??）：TODO(agent)")
    done < <(git ls-files --others --exclude-standard -- . ':(exclude).harness' 2>/dev/null)

    local total_files=${#diff_lines[@]}
    if [ "$total_files" -eq 0 ]; then
      files_section="- （无变更文件）"
    elif [ "$total_files" -gt 30 ]; then
      for ((i=0; i<30; i++)); do
        files_section="${files_section}${diff_lines[i]}"$'\n'
      done
      files_section="${files_section}- …共 ${total_files} 个文件"
    else
      for line in "${diff_lines[@]}"; do
        files_section="${files_section}${line}"$'\n'
      done
      files_section="${files_section%$'\n'}"
    fi
  fi

  local evidence_section=""
  local last_verify="$LOCKDIR/last-verify.txt"
  if [ -f "$last_verify" ]; then
    local v_first_line
    v_first_line=$(head -n 1 "$last_verify")
    local v_fp=""
    if [[ "$v_first_line" =~ fp=([A-Za-z0-9]+) ]]; then
      v_fp="${BASH_REMATCH[1]}"
    fi
    if [ -n "$v_fp" ] && [ "$v_fp" = "$cur_fp" ]; then
      evidence_section="- 证据指纹一致 ✅"$'\n'
      while IFS= read -r v_line; do
        [[ "$v_line" =~ ^# ]] && continue
        [[ "$v_line" =~ ^AUDIT ]] && continue
        [ -z "$v_line" ] && continue
        evidence_section="${evidence_section}${v_line}"$'\n'
      done < "$last_verify"
      evidence_section="${evidence_section%$'\n'}"
    else
      evidence_section="- STALE/NOT_RUN：证据与当前代码不一致，请先运行 hx verify"
    fi
  else
    evidence_section="- STALE/NOT_RUN：证据与当前代码不一致，请先运行 hx verify"
  fi

  local block
  block=$(cat <<EOF
<!-- HANDOFF BEGIN -->
## Handoff
- 时间：${cur_time} · 来源：TODO(agent) 填写宿主与模型
- 指纹：base=${base_sha} · fp=${cur_fp}
### ① 改动摘要
${files_section}
### ② 验证证据（hx 自动生成，禁止手改）
${evidence_section}
### ③ 已确认决策
- TODO(agent)
### ④ 未完成 / 风险
- TODO(agent)
### ⑤ 接力 Prompt
> TODO(agent)
<!-- HANDOFF END -->
EOF
)

  mkdir -p "$ROOT/.harness"
  local plan="$ROOT/.harness/PLAN.md"
  local todo_count
  todo_count=$(python3 -c '
import sys, os, re

plan_path = sys.argv[1]
block = sys.argv[2]

if not os.path.exists(plan_path):
    os.makedirs(os.path.dirname(plan_path), exist_ok=True)
    with open(plan_path, "w", encoding="utf-8") as f:
        f.write("# PLAN\n\n" + block + "\n")
else:
    with open(plan_path, "r", encoding="utf-8") as f:
        content = f.read()
    pattern = r"<!-- HANDOFF BEGIN -->[\s\S]*?<!-- HANDOFF END -->"
    if re.search(pattern, content):
        new_content = re.sub(pattern, lambda m: block, content)
    else:
        new_content = content.rstrip() + "\n\n" + block + "\n"
    with open(plan_path, "w", encoding="utf-8") as f:
        f.write(new_content)

todos = len(re.findall(r"TODO\(agent\)", block))
print(todos)
' "$plan" "$block")

  echo "HANDOFF written: $plan (TODO 数: $todo_count)"
  return 0
}

map_check(){
  local map_file="$ROOT/PROJECT_MAP.md"
  [ ! -f "$map_file" ] && { echo "NO_MAP"; return 2; }

  python3 -c '
import sys, os, re, subprocess

map_file = sys.argv[1]
root = sys.argv[2]
threshold = int(os.environ.get("HX_MAP_THRESHOLD", "5"))

with open(map_file, "r", encoding="utf-8") as f:
    lines = [f.readline() for _ in range(5)]

anchor_sha = None
for l in lines:
    m = re.search(r"<!--\s*map-commit:\s*([A-Za-z0-9]+)\s*-->", l)
    if m:
        anchor_sha = m.group(1)
        break

if not anchor_sha or anchor_sha == "none":
    print("NO_ANCHOR")
    sys.exit(2)

with open(map_file, "r", encoding="utf-8") as f:
    content = f.read()

tokens = re.findall(r"`([A-Za-z0-9_.@\-/]+/[A-Za-z0-9_.@\-/]*)`", content)
missing = []
for t in tokens:
    cleaned_path = t.rstrip("/")
    if not cleaned_path:
        continue
    full_path = os.path.join(root, cleaned_path)
    if not os.path.exists(full_path):
        if cleaned_path not in missing:
            missing.append(cleaned_path)

sha_valid = subprocess.run(["git", "cat-file", "-e", f"{anchor_sha}^{{commit}}"], cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

structural = 0
if not sha_valid:
    structural = threshold + 999
else:
    res = subprocess.run(["git", "diff", "--name-status", f"{anchor_sha}..HEAD"], cwd=root, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    if res.returncode == 0:
        for line in res.stdout.splitlines():
            if line:
                status = line.split()[0]
                if status[0] in ("A", "D", "R"):
                    structural += 1

missing_count = len(missing)
if missing_count > 0 or structural >= threshold:
    print(f"STALE (structural={structural}, missing={missing_count})")
    for p in missing[:10]:
        print(p)
    sys.exit(1)
else:
    print(f"FRESH (structural={structural})")
    sys.exit(0)
' "$map_file" "$ROOT"
}

GUARD_PY='
import sys,json,os,hashlib
j=json.loads(sys.argv[1]); a=j.get("toolCall",{}).get("args",{})
p=a.get("TargetFile") or a.get("Path") or a.get("AbsolutePath") or ""
root=sys.argv[2]
def out(d,r=""): print(json.dumps({"decision":d,"reason":r})); sys.exit(0)
if not p: out("allow")
if not os.path.realpath(p).startswith(os.path.realpath(root)): out("ask","Harness: 写入工作区之外")
rel=os.path.relpath(os.path.realpath(p),os.path.realpath(root))
lock=os.path.expanduser("~/.harness-locks/"+hashlib.sha1(root.encode()).hexdigest()[:12]+"/lock.sha")
if os.path.exists(lock) and any(l.split()[-1]==rel for l in open(lock) if l.strip()):
    out("deny","Harness: "+rel+" 是已锁定的验证入口，需用户批准 hx lock --refresh")
if "/" not in rel and rel.endswith((".py",".sh",".mjs")) and not os.path.exists(p):
    out("deny","Harness: 临时脚本请写到 .harness/ 或系统临时目录")
out("allow")'

case "${1:-}" in
  detect) detect ;;
  lock) lock "${2:-}" ;;
  baseline) baseline ;;
  verify) verify "${2:-}" ;;
  audit) audit ;;
  gc) gc ;;
  handoff) handoff "${2:-}" ;;
  map-check) map_check ;;
  guard)
    err=$(mktemp 2>/dev/null || echo "/tmp/hx-guard-err.log")
    if ! python3 -c "$GUARD_PY" "$IN" "$ROOT" 2>"$err"; then
      mkdir -p "$HOME/.harness-locks" 2>/dev/null || true
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] guard python3 failure: $(cat "$err" 2>/dev/null)" >> "$HOME/.harness-locks/guard-error.log" 2>/dev/null || true
      echo '{"decision":"allow"}'
    fi
    rm -f "$err" ;;
  stop) { in_git && ! git diff --quiet 2>/dev/null && mkdir -p "$LOCKDIR" && audit > "$LOCKDIR/last-audit.txt" 2>&1; } ; echo '{}' ;;
  *) sed -n '2,4p' "$0"; exit 2 ;;
esac
